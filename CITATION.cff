    given-names: Zafer
    affiliation: "Department of Materials Science and Engineering, University of Arizona"
    # orcid: "https://orcid.org/0000-0000-0000-0000"
repository-code: "https://github.com/zmutlulab/raman-peak-extractor"
license: MIT
keywords:
  - Raman spectroscopy
  - peak fitting
  - baseline correction
  - graphene nanoribbons
  - Lorentzian
